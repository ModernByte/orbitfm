+/// SoA-набор точек на единичной сфере (или уже в world после [`Self::deform_into`]).
+///
+/// Координаты станций кладутся один раз при смене списка; каждый кадр — только
+/// `deform_into` + [`crate::render::GlobeCamera::project_points_on_sphere_soa`].
+#[derive(Debug, Clone, Default)]
+pub struct SpherePointSoA {
+    pub x: Vec<f32>,
+    pub y: Vec<f32>,
+    pub z: Vec<f32>,
+}
+
+impl SpherePointSoA {
+    pub fn with_capacity(capacity: usize) -> Self {
+        Self {
+            x: Vec::with_capacity(capacity),
+            y: Vec::with_capacity(capacity),
+            z: Vec::with_capacity(capacity),
+        }
+    }
+
+    pub fn len(&self) -> usize {
+        self.x.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.x.is_empty()
+    }
+
+    pub fn clear(&mut self) {
+        self.x.clear();
+        self.y.clear();
+        self.z.clear();
+    }
+
+    /// Добавляет точку единичной сферы по широте/долготе в градусах.
+    pub fn push_lat_lon(&mut self, lat_deg: f32, lon_deg: f32) {
+        let p = sphere_point(lat_deg, lon_deg);
+        self.x.push(p.x);
+        self.y.push(p.y);
+        self.z.push(p.z);
+    }
+
+    /// Перестраивает буфер из пар (lat, lon) в градусах.
+    pub fn fill_lat_lons<I>(&mut self, coords: I)
+    where
+        I: IntoIterator<Item = (f32, f32)>,
+    {
+        self.clear();
+        for (lat, lon) in coords {
+            self.push_lat_lon(lat, lon);
+        }
+    }
+
+    /// Пишет деформированные world-координаты в `out_*` (длины совпадают с `self`).
+    pub fn deform_into(
+        &self,
+        deform: super::motion::GlobeDeform,
+        out_x: &mut Vec<f32>,
+        out_y: &mut Vec<f32>,
+        out_z: &mut Vec<f32>,
+    ) {
+        let n = self.len();
+        out_x.clear();
+        out_y.clear();
+        out_z.clear();
+        out_x.reserve(n);
+        out_y.reserve(n);
+        out_z.reserve(n);
+        let sx = deform.scale_xz();
+        let sy = deform.scale_y();
+        for i in 0..n {
+            out_x.push(self.x[i] * sx);
+            out_y.push(self.y[i] * sy);
+            out_z.push(self.z[i] * sx);
+        }
+    }
+}
+
+/// Переиспользуемые буферы батч-обработки маркеров (SoA → проекция → visuals).
+///
+/// Держите экземпляр между кадрами (в state UI), чтобы не аллоцировать
+/// `Vec` на каждый frame при стабильном N. Горячий путь — плотные `f32`
+/// массивы без `Option` в цикле проекции (удобно для авто-SIMD LLVM).
+#[derive(Debug, Default, Clone)]
+pub struct MarkerBatchScratch {
+    unit: SpherePointSoA,
+    world_x: Vec<f32>,
+    world_y: Vec<f32>,
+    world_z: Vec<f32>,
+    /// Экранные позиции видимых маркеров (параллельно [`Self::indices`]).
+    pub positions: Vec<Pos2>,
+    /// Индекс исходной станции/маркера во входном порядке `lat_lon`.
+    pub indices: Vec<u32>,
+}
+
+impl MarkerBatchScratch {
+    pub fn with_capacity(capacity: usize) -> Self {
+        Self {
+            unit: SpherePointSoA::with_capacity(capacity),
+            world_x: Vec::with_capacity(capacity),
+            world_y: Vec::with_capacity(capacity),
+            world_z: Vec::with_capacity(capacity),
+            positions: Vec::with_capacity(capacity),
+            indices: Vec::with_capacity(capacity),
+        }
+    }
+
+    pub fn clear_outputs(&mut self) {
+        self.positions.clear();
+        self.indices.clear();
+    }
+
+    /// Полный CPU-проход: lat/lon → unit SoA → deform → SoA-проекция.
+    ///
+    /// `lat_lon` — порядок исходных маркеров; в `indices` попадают только
+    /// прошедшие back-face / viewport.
+    pub fn project_lat_lons(
+        &mut self,
+        camera: &super::camera::GlobeCamera,
+        viewport: Rect,
+        deform: super::motion::GlobeDeform,
+        lat_lon: impl IntoIterator<Item = (f32, f32)>,
+    ) {
+        self.unit.fill_lat_lons(lat_lon);
+        self.unit
+            .deform_into(deform, &mut self.world_x, &mut self.world_y, &mut self.world_z);
+        camera.project_points_on_sphere_soa(
+            &self.world_x,
+            &self.world_y,
+            &self.world_z,
+            viewport,
+            &mut self.positions,
+            &mut self.indices,
+        );
+    }
+
+    /// Собирает [`MarkerVisual`] для видимых точек.
+    ///
+    /// `playing` / `selected` индексируются **исходным** индексом маркера
+    /// (как во входе `project_lat_lons`), не индексом в `positions`.
+    pub fn build_visuals(
+        &self,
+        playing: &[bool],
+        selected: &[bool],
+        out: &mut Vec<MarkerVisual>,
+    ) {
+        out.clear();
+        out.reserve(self.positions.len());
+        for (slot, src) in self.indices.iter().enumerate() {
+            let src = *src as usize;
+            out.push(MarkerVisual {
+                pos: self.positions[slot],
+                playing: playing.get(src).copied().unwrap_or(false),
+                selected: selected.get(src).copied().unwrap_or(false),
+            });
+        }
+    }
+
+    /// Пары (src_index, screen) — для hit-test / nearest.
+    pub fn screen_pairs(&self) -> impl Iterator<Item = (usize, Pos2)> + '_ {
+        self.indices
+            .iter()
+            .zip(self.positions.iter())
+            .map(|(&i, &p)| (i as usize, p))
+    }
+}
