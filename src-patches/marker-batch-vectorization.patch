+/// Векторизованный (SoA) проход: проекция + флаги playing/selected → [`MarkerVisual`].
+fn marker_visuals_batch(
+    camera: &GlobeCamera,
+    markers: &[GlobeMarker],
+    viewport: egui::Rect,
+    deform: &GlobeDeform,
+    current_uuid: Option<&str>,
+    selected_uuid: Option<&str>,
+) -> (Vec<(usize, egui::Pos2)>, Vec<MarkerVisual>) {
+    if markers.is_empty() {
+        return (Vec::new(), Vec::new());
+    }
+    let mut scratch = MarkerBatchScratch::with_capacity(markers.len());
+    scratch.project_lat_lons(
+        camera,
+        viewport,
+        *deform,
+        markers.iter().map(|marker| (marker.lat, marker.lon)),
+    );
+
+    // Флаги — плотные параллельные массивы по исходному индексу (без branch в project).
+    let mut playing = vec![false; markers.len()];
+    let mut selected = vec![false; markers.len()];
+    for (i, marker) in markers.iter().enumerate() {
+        if let Some(uuid) = current_uuid {
+            playing[i] = marker.members.iter().any(|member| member == uuid);
+        }
+        if let Some(uuid) = selected_uuid {
+            selected[i] = marker.members.iter().any(|member| member == uuid);
+        }
+    }
+
+    let mut visuals = Vec::new();
+    scratch.build_visuals(&playing, &selected, &mut visuals);
+    let screens = scratch.screen_pairs().collect();
+    (screens, visuals)
 }
 
