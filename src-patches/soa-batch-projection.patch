+/// Общая проекция для [`GlobeCamera::project_on_sphere`] и AoS-батча.
+fn project_point_eye_vp(
+    view_proj: Mat4,
+    eye: Vec3,
+    point: Vec3,
+    viewport: Rect,
+) -> Option<Pos2> {
+    if point.dot(eye) <= point.length_squared() {
+        return None;
+    }
+    let clip = view_proj * point.extend(1.0);
+    if clip.w <= f32::EPSILON {
+        return None;
+    }
+    let ndc = clip.truncate() / clip.w;
+    let position = Pos2::new(
+        viewport.left() + (ndc.x * 0.5 + 0.5) * viewport.width(),
+        viewport.top() + (0.5 - ndc.y * 0.5) * viewport.height(),
+    );
+    (position.x.is_finite() && position.y.is_finite() && viewport.contains(position)).then_some(position)
+}
