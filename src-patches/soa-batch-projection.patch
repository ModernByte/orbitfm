+/// SoA-набор точек на единичной сфере (или уже в world после [`Self::deform_into`]).
+///
+/// Координаты станций кладутся один раз при смене списка; каждый кадр — только
+/// `deform_into` + [`crate::render::GlobeCamera::project_points_on_sphere_soa`].
+#[derive(Debug, Clone, Default)]
+pub struct SpherePointSoA {
+    pub x: Vec<f32>,
+    pub y: Vec<f32>,
+    pub z: Vec<f32>,
+}
+
+impl SpherePointSoA {
+    pub fn with_capacity(capacity: usize) -> Self {
+        Self {
+            x: Vec::with_capacity(capacity),
+            y: Vec::with_capacity(capacity),
+            z: Vec::with_capacity(capacity),
+        }
+    }
+
+    pub fn len(&self) -> usize {
+        self.x.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.x.is_empty()
+    }
+
+    pub fn clear(&mut self) {
+        self.x.clear();
+        self.y.clear();
+        self.z.clear();
+    }
+
+    /// Добавляет точку единичной сферы по широте/долготе в градусах.
+    pub fn push_lat_lon(&mut self, lat_deg: f32, lon_deg: f32) {
+        let p = sphere_point(lat_deg, lon_deg);
+        self.x.push(p.x);
+        self.y.push(p.y);
+        self.z.push(p.z);
+    }
+
+    /// Перестраивает буфер из пар (lat, lon) в градусах.
+    pub fn fill_lat_lons<I>(&mut self, coords: I)
+    where
+        I: IntoIterator<Item = (f32, f32)>,
+    {
+        self.clear();
+        for (lat, lon) in coords {
+            self.push_lat_lon(lat, lon);
+        }
+    }
+
+    /// Пишет деформированные world-координаты в `out_*` (длины совпадают с `self`).
+    pub fn deform_into(
+        &self,
+        deform: super::motion::GlobeDeform,
+        out_x: &mut Vec<f32>,
+        out_y: &mut Vec<f32>,
+        out_z: &mut Vec<f32>,
+    ) {
+        let n = self.len();
+        out_x.clear();
+        out_y.clear();
+        out_z.clear();
+        out_x.reserve(n);
+        out_y.reserve(n);
+        out_z.reserve(n);
+        let sx = deform.scale_xz();
+        let sy = deform.scale_y();
+        for i in 0..n {
+            out_x.push(self.x[i] * sx);
+            out_y.push(self.y[i] * sy);
+            out_z.push(self.z[i] * sx);
+        }
+    }
+}
